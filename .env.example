# TradeMind — Environment Variables
# ====================================
# کپی این فایل را به .env بسازید و مقادیر را پر کنید.
# Copy this file to .env and fill in your values.

# ── Supabase ──────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Google Gemini AI ──────────────────────────────
# از https://aistudio.google.com/app/apikey بگیرید
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── CoinEx (اختیاری — برای endpoint های عمومی نیازی نیست) ──
# VITE_COINEX_API_KEY=
# VITE_COINEX_API_SECRET=
